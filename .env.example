# MATCHFLOW environment (map into wp-config.php, Docker env, or Settings → MATCHFLOW)

# NEAR Intents 1Click
MATCHFLOW_NEAR_INTENTS_JWT=
MATCHFLOW_NEAR_INTENTS_API_KEY=
MATCHFLOW_NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com
MATCHFLOW_1CLICK_PUBLIC_KEY=
MATCHFLOW_NEAR_INTENTS_SIGNING_KEY=
MATCHFLOW_NEAR_RPC_URL=

# Local dry-run only — never enable in production
MATCHFLOW_ALLOW_UNVERIFIED_QUOTES=false

# Finance AI (OpenAI-compatible)
MATCHFLOW_AI_PROVIDER=openrouter
MATCHFLOW_AI_API_KEY=
MATCHFLOW_AI_BASE_URL=
MATCHFLOW_AI_MODEL=

# Frontend
MATCHFLOW_VITE_DEV_SERVER=

# Optional fingerprint softening (generator/RSD) — off by default
MATCHFLOW_STRIP_FINGERPRINTS=false

# Uninstall
MATCHFLOW_DELETE_DATA_ON_UNINSTALL=false
