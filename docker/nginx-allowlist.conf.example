# Optional hardened reverse proxy (P2). Not required for plugin ZIP on stock WordPress.
# Example allowlist for MATCHFLOW public surfaces.

location /api/v1/ {
  proxy_pass http://wordpress:80/api/v1/;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

location ~ ^/(app|pay|receipt|supplier|login|register|onboarding|forgot-password|reset-password)(/|$) {
  proxy_pass http://wordpress:80;
  proxy_set_header Host $host;
}

# Prefer static hashed assets from the plugin build dir when fronting the site:
# location /wp-content/plugins/matchflow/assets/build/ { alias /var/www/html/wp-content/plugins/matchflow/assets/build/; expires 7d; }
